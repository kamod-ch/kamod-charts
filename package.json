{
  "name": "kamod-charts",
  "version": "0.0.0",
  "private": true,
  "description": "Preact-native SVG chart library workspace for @kamod-ch/charts.",
  "homepage": "https://kamod-ch.github.io/kamod-charts/",
  "license": "MIT",
  "author": "Klaus Zahiragic <watzak>",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter !@kamod-ch/charts-docs build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "pnpm -r --filter !@kamod-ch/charts-docs test",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium",
    "test:exports": "pnpm build && node scripts/test-package-exports.mjs",
    "size:report": "pnpm build && node scripts/bundle-size-report.mjs",
    "bench:browser": "node scripts/browser-benchmark.mjs",
    "smoke:consumer": "pnpm --filter @kamod-ch/charts build && node scripts/consumer-smoke.mjs",
    "consumer:report": "node scripts/consumer-bundle-report.mjs",
    "docs:dev": "pnpm --filter @kamod-ch/charts-docs dev",
    "docs:build": "pnpm --filter @kamod-ch/charts-docs build",
    "build:docs": "pnpm --filter @kamod-ch/charts-docs build",
    "docs:preview": "pnpm --filter @kamod-ch/charts-docs preview",
    "ci": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && node scripts/test-package-exports.mjs && pnpm docs:build && pnpm size:report && git diff --exit-code -- docs/bundle-size.md",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && node scripts/test-package-exports.mjs",
    "release:check": "pnpm run ci",
    "release:auth": "npm whoami --registry=https://registry.npmjs.org || (echo 'Authenticate with: npm login (or set NODE_AUTH_TOKEN)' >&2; exit 1)",
    "release:publish": "pnpm --filter @kamod-ch/charts publish --access public --provenance --no-git-checks"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^25.9.2",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.17.0"
}
